# ── Network. Active values below = ARC MAINNET (5042). Testnet block (5042002) is commented for local experiments. ──
# Sources (verified live 2026-10-11):
#   RPC/explorer:  https://docs.arc.io/arc/references/connect-to-arc  ·  https://docs.arc.io/arc/references/rpc-endpoints
#                  (public endpoints, no key; eth_getLogs ≤10,000 blocks/request, ≤2,000 results/query)
#   contracts:     https://docs.arc.io/arc/references/contract-addresses  (USDC = 0x3600…0000 on BOTH networks;
#                  NativeFiatTokenV2 proxy, ERC-20 interface 6 dp; native gas USDC is 18 dp)
#   USDC logs:     https://docs.arc.io/arc/references/usdc-system-events  (every USDC movement logs Transfer from the
#                  system emitter 0xffff…fffE at 18 dp — the ERC-20 address only logs ERC-20 calls)
#   blocklist:     https://docs.arc.io/integrate/infrastructure/compliance  (USDC contract blocklist, isBlacklisted();
#                  no separate protocol-level blocklist contract is documented → PROTOCOL_BLOCKLIST_ADDRESS stays empty)
#   viem 2.57 chain defs: node_modules/viem/chains/definitions/arc.ts, arcTestnet.ts
#
# ── Arc MAINNET (chain 5042) — active ──
ARC_CHAIN_ID=5042
ARC_RPC_URL=https://rpc.mainnet.arc.io
#   alternates: https://rpc.blockdaemon.mainnet.arc.io  https://rpc.drpc.mainnet.arc.io  https://rpc.quicknode.mainnet.arc.io
ARC_EXPLORER_URL=https://explorer.arc.io
#   explorer.arc.io API sits behind a Cloudflare challenge for non-browser clients (2026-10-11); leave empty → RPC fallback
ARC_BLOCKSCOUT_API=
USDC_ADDRESS=0x3600000000000000000000000000000000000000
REGISTRY_ADDRESS=
PROTOCOL_BLOCKLIST_ADDRESS=
#
# ── Arc TESTNET (chain 5042002) — for local experiments ──
# ARC_CHAIN_ID=5042002
# ARC_RPC_URL=https://rpc.testnet.arc.io
#   alternates: https://rpc.blockdaemon.testnet.arc.io  https://rpc.drpc.testnet.arc.io  https://rpc.quicknode.testnet.arc.io
# ARC_EXPLORER_URL=https://explorer.testnet.arc.io
#   explorer.arc.io is Blockscout too, but its API sat behind a Cloudflare browser challenge for curl on 2026-10-11;
#   the collector falls back to RPC (nonce + funder trace) when this fails. Leave empty to skip Blockscout on mainnet.
# ARC_BLOCKSCOUT_API=https://explorer.testnet.arc.io/api
# USDC_ADDRESS=0x3600000000000000000000000000000000000000
# REGISTRY_ADDRESS=
# PROTOCOL_BLOCKLIST_ADDRESS=
#
# ── Evidence collector tunables (all optional) ──
# contract whose Transfer logs the funder trace reads. default = system emitter (18 dp). Set to USDC_ADDRESS to trace
# only ERC-20 interface calls (6 dp) — not recommended, native sends would be missed.
# ARC_USDC_EMITTER=0xffffFFFfFFffffffffffffffFfFFFfffFFFfFFfE
# ARC_USDC_EMITTER_DECIMALS=18
# EVIDENCE_LOOKBACK_BLOCKS=50000        # ~2 blocks/s → ≈7 h of history per traced wallet
# EVIDENCE_GETLOGS_CHUNK=9999           # public RPC hard cap is 10,000
# EVIDENCE_SOURCE_TIMEOUT_MS=4000
# YENTE_DATASET=default                 # or "sanctions" (docker/yente/manifest.yml indexes only that scope)
# YENTE_THRESHOLD=0.7
# OVERRIDES_PATH=.data/overrides.json   # demo overrides on our own wallets (never a real sanctioned address)
# OVERRIDES_JSON=                       # inline JSON; wins over the file when set

# ── Keys (never commit real values) ──
ATTESTER_PRIVATE_KEY=
ANTHROPIC_API_KEY=
ANALYST_MODEL=claude-sonnet-5-5

# ── Data ──
YENTE_URL=http://localhost:8000
DATABASE_URL=file:./.data/complir.db
DATABASE_AUTH_TOKEN=

# ── Payments (x402 v2 via Circle Facilitator Service on Arc; docs: developers.circle.com/facilitator-service) ──
# X402_NETWORK is CAIP-2: Arc testnet eip155:5042002, Arc mainnet eip155:5042 (defaults to eip155:$ARC_CHAIN_ID).
# USDC on Arc (both nets) = 0x3600000000000000000000000000000000000000 (USDC_ADDRESS above; EIP-712 domain USDC/2).
X402_DISABLED=1
X402_NETWORK=
X402_PAY_TO=
X402_FACILITATOR_URL=https://api.circle.com/v1/facilitator/x402
# Auth for the facilitator — exactly one of:
#   X402_FACILITATOR_API_KEY  → Authorization: Bearer (Circle Console key; required for production settle)
#   X402_SELLER_PRIVATE_KEY   → Facilitator-Seller-Proof signed by the X402_PAY_TO key (keyless trial, no account)
X402_FACILITATOR_API_KEY=
X402_SELLER_PRIVATE_KEY=
# Optional: token EIP-712 domain override (default USDC / 2), status polls after settlement_pending (default 3)
X402_ASSET_NAME=
X402_ASSET_VERSION=
X402_PENDING_POLLS=
PRICE_SCREEN_USDC=0.01
PRICE_WATCH_USDC=0.05

# ── Ops ──
COMPLIR_PAUSED=0
ANCHOR_EVERY_N=50
PUBLIC_BASE_URL=http://localhost:3000

# ── Traction accounting: our own wallets, excluded from /numbers (comma-separated) ──
OWN_WALLETS=
# ── Watcher cron auth (POST /api/internal/watcher) ──
CRON_SECRET=

# ── Guarded Payouts demo (treasury agent that pays through GuardedTreasury; dry-run unless all four live vars set) ──
TREASURY_MODE=                    # "live" sends real USDC; anything else = dry-run
TREASURY_PRIVATE_KEY=             # owner of GuardedTreasury (pays USDC gas)
GUARDED_TREASURY_ADDRESS=         # from contracts/script/Deploy.s.sol:DeployGuardedTreasury
TREASURY_MAX_TIER=MEDIUM
TREASURY_PER_PAYOUT_CAP_USDC=25
TREASURY_DAILY_CAP_USDC=50
TREASURY_REQUIRE_ONCHAIN=         # default: true in live, false in dry-run

# ── Arc Trust Map (live chain monitor) ──
TRUSTMAP_MIN_USDC=25              # grade recipients receiving at least this much USDC per tick window
TRUSTMAP_REGRADE_HOURS=24
TRUSTMAP_MAX_PER_TICK=5
TRUSTMAP_SEED_DEMO=1              # seed the three demo nodes when the map is empty

# ── USYC revenue sweep — ALTERNATIVE backend (YIELD_BACKEND=usyc). Permissioned (Circle/Hashnote onboarding, ~100k min);
#    dry-run unless USYC_MODE=live; live needs an entitled wallet + REVENUE_PRIVATE_KEY — see docs/YIELD.md § USYC ──
USYC_MODE=dry
USYC_FLOAT_USDC=5
USYC_MIN_SWEEP_USDC=1
REVENUE_WALLET=                   # dry-run read address (defaults to X402_PAY_TO)
REVENUE_PRIVATE_KEY=              # live only; must control X402_PAY_TO
# USYC_ADDRESS / USYC_TELLER_ADDRESS / USYC_ENTITLEMENTS_ADDRESS default to Arc mainnet values

# ── ERC-8004 agent identity (docs/ERC8004.md; `node --env-file=.env.local scripts/erc8004/register.ts --print`) ──
ERC8004_IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_OWNER_PRIVATE_KEY=        # falls back to ATTESTER_PRIVATE_KEY
ERC8004_AGENT_ID=                 # set after registration

# ── Circle Developer-Controlled Wallets + Gas Station (docs/CIRCLE_WALLETS.md; SDK @circle-fin/developer-controlled-wallets) ──
# Dry-run until BOTH CIRCLE_API_KEY and CIRCLE_ENTITY_SECRET are set; then `node --env-file=.env.local scripts/circle/setup.ts`.
# Circle blockchain id follows ARC_CHAIN_ID: 5042 → ARC (mainnet), 5042002 → ARC-TESTNET (developers.circle.com/wallets/supported-blockchains).
SIGNER_MODE=local                 # local | circle — circle = relay attest() through the Circle "ops" wallet (falls back to local when unset)
CIRCLE_API_KEY=                   # console.circle.com → API Keys (mainnet toggle for Arc mainnet)
CIRCLE_ENTITY_SECRET=             # 32-byte hex: `node scripts/circle/setup.ts --generate-secret`, register once with `--register`
CIRCLE_WALLET_SET_ID=             # printed by setup.ts (optional: resolved by name otherwise)
CIRCLE_WALLET_SET_NAME=complir
CIRCLE_ACCOUNT_TYPE=SCA           # SCA = Gas Station-sponsorable (default) · EOA = plain key (required if a Circle wallet must be the registry attester)
CIRCLE_FEE_LEVEL=MEDIUM           # LOW | MEDIUM | HIGH
CIRCLE_TX_TIMEOUT_MS=120000       # polling budget for a Circle transaction to reach a tx hash
# CIRCLE_BASE_URL=https://api.circle.com
# App-enforced spending policy per wallet (src/lib/circle/wallets.ts). Circle-side caps exist only for Agent Wallets (Circle CLI).
CIRCLE_OPS_POLICY_PER_TX_USDC=1
CIRCLE_OPS_POLICY_DAILY_USDC=10
CIRCLE_OPS_POLICY_ALLOWLIST=      # comma-separated contracts; defaults to REGISTRY_ADDRESS
CIRCLE_REVENUE_POLICY_PER_TX_USDC=25
CIRCLE_REVENUE_POLICY_DAILY_USDC=100
CIRCLE_REVENUE_POLICY_ALLOWLIST=  # comma-separated recipients for transfers + contract calls; empty = any
CIRCLE_REVENUE_POLICY_CONTRACT_ALLOWLIST= # contract-call targets only (USDC + yield vault); empty = any. Stored policy wins:
                                  # `npx tsx --env-file=.env.local scripts/circle/allow-contracts.ts revenue <USDC> <vault>`

# ── Operator agent (runs the company: sweep/payout/price decisions; /company) ──
OPERATOR_RAISE_CALLS_24H=50       # paid calls/24h above which a price raise becomes a candidate
OPERATOR_MAX_P95_MS=8000

# ── Auto-refunds (settled but undelivered → refund; dry-run without a key) ──
REFUND_PRIVATE_KEY=               # or REVENUE_PRIVATE_KEY; Circle revenue wallet is used when configured
REFUND_DAILY_CAP_USDC=5
REFUND_MAX_ATTEMPTS=3
REFUND_AUTO_PROCESS=1

# ── Signed daily report (/report; notes/mistakes in .data/report-notes.json) ──
REPORT_NOTES_PATH=.data/report-notes.json
REPORT_INTEGRATIONS_DIR=docs/integrations

# ── Tip market (/tips; stake via x402, verified tips paid in USDC) ──
TIPS_STAKE_USDC=0.05
TIP_BOUNTY_USDC=0.25
TIPS_DAILY_CAP_USDC=5
TIPS_PAYOUT_PRIVATE_KEY=          # local payout rail; Circle revenue wallet used when configured
TIPS_STAKE_GRACE_SECONDS=600

# ── Event-driven re-grades (USDC Blacklisted/UnBlacklisted events on Arc → instant re-screen + webhooks) ──
EVENTS_TICK_MS=20000
EVENTS_MAX_BLOCKS=500
EVENTS_MAX_LAG=5000
EVENTS_RPC_BUDGET=12
EVENTS_SCREENED_DAYS=30
# ── Cross-client network signal ──
NETWORK_WINDOW_DAYS=7
NETWORK_MIN_CONCENTRATION=3

# ── LLM provider for the Risk Analyst + Operator (docs/LLM_PROVIDERS.md; src/lib/llm) ──
# LLM_PROVIDER=anthropic | 0g | none.  Unset → anthropic if ANTHROPIC_API_KEY, else 0g if ZEROG_API_KEY, else none
# (deterministic fallback, meta.fallback=true). Guards, prompts and schemas are identical on every provider.
LLM_PROVIDER=
LLM_MODEL=                        # overrides ANALYST_MODEL for whichever provider is active
LLM_TIMEOUT_MS=                   # default 8000 (anthropic) / 30000 (0g — relayed Claude providers report 4–11 s)
# 0G Compute Router (verified 2026-10-13): hosted gateway, no wallet key in the app. Claude models ARE listed
# (claude-sonnet-5 $1.90/$9.50 per M, claude-opus-5, claude-opus-4-8, claude-fable-5 …) and are served over the Anthropic
# Messages format (/v1/messages); they are relayed upstream, NOT TEE-attested (verifiability absent in /v1/models).
#   1. https://pc.0g.ai → connect wallet (or Privy social login) → Dashboard → Deposit 0G tokens (Router mode, 0G Payment Layer)
#   2. Dashboard → API Keys → Create → ZEROG_API_KEY=sk-… (shown once)
#   3. node --env-file=.env.local scripts/zerog/setup.ts            # catalog + live providers (free)
#      node --env-file=.env.local scripts/zerog/setup.ts --verify   # one paid round trip
ZEROG_API_KEY=                    # sk-… inference key — billed per token against the deposit
ZEROG_MANAGEMENT_KEY=             # optional mk-… key (scope account:read) for `setup.ts --balance`
ZEROG_MODEL=claude-sonnet-5       # router model id (see `setup.ts --models`); ANALYST_MODEL=claude-sonnet-5-5 is NOT a router id
ZEROG_BASE_URL=https://router-api.0g.ai
ZEROG_FORMAT=auto                 # auto = anthropic (/v1/messages) for claude-*, openai (/v1/chat/completions) otherwise

# ── Revenue yield sweep via Circle Earn (default backend; docs/YIELD.md) ──
# Idle revenue-wallet USDC above the float goes into the best Circle Earn vault on Arc (Morpho USDC, ERC-4626, no allowlist),
# executed from the Circle `revenue` wallet (approve → deposit / redeem). Dry-run (plan logged) unless YIELD_MODE=live.
YIELD_BACKEND=earn                # earn (default) | usyc (legacy, permissioned)
YIELD_MODE=dry                    # dry | live (live needs Circle wallets + REVENUE_WALLET = the Circle revenue wallet)
YIELD_FLOAT_USDC=5                # cushion kept liquid; the operator adds obligations due within 48 h
YIELD_MIN_SWEEP_USDC=1            # ignore moves smaller than this
YIELD_MAX_SWEEP_USDC=25           # cap per deposit (keep ≤ CIRCLE_REVENUE_POLICY_PER_TX_USDC)
YIELD_MIN_TVL_USDC=100000         # skip small / test vaults
YIELD_REQUIRE_SENTINEL=1          # only vaults Circle Earn marks riskSignals.circleSentinel
YIELD_LIQUIDITY_MULTIPLE=2        # vault liquidity must be ≥ N × (deposit + position)
YIELD_VAULT=                      # optional: pin one vault (still has to pass every rule)
YIELD_EARN_API_URL=               # default https://api.circle.com (GET /v1/earnKit/vaults/explore, keyless)
YIELD_EARN_API_KEY=               # optional Circle API key (server-only)
