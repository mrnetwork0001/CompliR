{
  "manifest_version": 3,
  "name": "CompliR",
  "version": "0.2.0",
  "description": "Risk tier chips after every EVM address you browse, and a warning before you send to a sanctioned or blocklisted wallet. Verdicts from the CompliR oracle on Arc.",
  "minimum_chrome_version": "110",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CompliR",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "lib/parser.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "exclude_matches": [
        "https://trycomplir.xyz/*",
        "https://www.trycomplir.xyz/*",
        "https://*.sslip.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ]
}
