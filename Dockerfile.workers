# CompliR background workers (watcher, trust-map tailer, events, treasury, operator, tips, refunds, usyc, report)
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
RUN npm i -g tsx@4
ENV NODE_ENV=production
CMD ["tsx", "worker/all.ts"]
