index 0000000..d50ec97
--- /dev/null
+++ b/agent/complir.py
@@ -0,0 +1,78 @@
+"""CompliR: counterparty risk oracle on Arc (score 0–100, tier, recommended limit, signed verdict). Off unless COMPLIR_URL
+is set; the local denylist in screen.py always runs first and still wins. One x402 call (0.01 USDC) per screen, signed
+with COMPLIR_PAYER_PRIVATE_KEY (EIP-3009 TransferWithAuthorization); without a payer key an unpaid 402 is logged and ignored."""
+import base64
+import json
+import logging
+import os
+import time
+from typing import Optional
+
+import httpx
+from eth_account import Account
+from web3 import Web3
+
+from config import COMPLIR_PAYER_PRIVATE_KEY, COMPLIR_TIMEOUT, COMPLIR_URL
+
+log = logging.getLogger("steward.complir")
+_AUTH_TYPES = {"TransferWithAuthorization": [{"name": "from", "type": "address"}, {"name": "to", "type": "address"},
+                                             {"name": "value", "type": "uint256"}, {"name": "validAfter", "type": "uint256"},
+                                             {"name": "validBefore", "type": "uint256"}, {"name": "nonce", "type": "bytes32"}]}
+
+
+def _payment_header(required: dict) -> Optional[str]:
+    """Signs the first `exact` / eip155 requirement of a 402 (x402 v2) with the payer key. None when there is no key."""
+    if not COMPLIR_PAYER_PRIVATE_KEY:
+        return None
+    req = next((a for a in required.get("accepts", []) if a.get("scheme") == "exact" and str(a.get("network", "")).startswith("eip155:")), None)
+    if req is None or int(req["amount"]) > 1_000_000:       # never sign for more than 1 USDC per call
+        return None
+    extra = req.get("extra") or {}
+    acct = Account.from_key(COMPLIR_PAYER_PRIVATE_KEY)
+    auth = {"from": acct.address, "to": req["payTo"], "value": str(req["amount"]), "validAfter": "0",
+            "validBefore": str(int(time.time()) + int(req.get("maxTimeoutSeconds", 60)) + 540), "nonce": Web3.to_hex(os.urandom(32))}
+    domain = {"name": extra.get("name", "USDC"), "version": extra.get("version", "2"), "chainId": int(req["network"].split(":")[1]),
+              "verifyingContract": req["asset"]}
+    msg = {**auth, "value": int(auth["value"]), "validAfter": 0, "validBefore": int(auth["validBefore"]), "nonce": bytes.fromhex(auth["nonce"][2:])}
+    sig = Web3.to_hex(Account.sign_typed_data(COMPLIR_PAYER_PRIVATE_KEY, domain, _AUTH_TYPES, msg).signature)
+    payload = {"x402Version": 2, "resource": required.get("resource"), "accepted": req, "payload": {"signature": sig, "authorization": auth}}
+    return base64.b64encode(json.dumps(payload).encode()).decode()
+
+
+def verdict(addr: str, requested: int) -> Optional[dict]:
+    """POST /api/v1/screen → verdict dict (tier, score, recommendedLimits, decisionId, attestation) or None when CompliR is
+    off, unpaid or unreachable. A None never changes a decision: the denylist and the caps still apply as before."""
+    if not COMPLIR_URL:
+        return None
+    url, body = f"{COMPLIR_URL.rstrip('/')}/api/v1/screen", {"address": addr, "amountUsdc": requested / 1e6, "clientId": "steward"}
+    try:
+        with httpx.Client(timeout=COMPLIR_TIMEOUT) as c:
+            r = c.post(url, json=body)
+            if r.status_code == 402:
+                required = r.headers.get("PAYMENT-REQUIRED")
+                sig = _payment_header(json.loads(base64.b64decode(required)) if required else r.json())
+                if sig is None:
+                    log.warning("complir: 402 and no COMPLIR_PAYER_PRIVATE_KEY; screened by denylist only")
+                    return None
+                r = c.post(url, json=body, headers={"PAYMENT-SIGNATURE": sig})
+            r.raise_for_status()
+            v = r.json()
+            log.info("complir %s tier=%s score=%s maxPerTx=%s decision=%s", addr[:10], v.get("tier"), v.get("score"),
+                     (v.get("recommendedLimits") or {}).get("maxPerTxUsdc"), v.get("decisionId"))
+            return v
+    except Exception as e:                                   # a screening outage is logged, never a crash of the decide loop
+        log.warning("complir: %s", e)
+        return None
+
+
+def apply(v: Optional[dict], payee_screen: str, per_tx_cap: int) -> tuple[str, int]:
+    """Maps a verdict onto the rules engine's inputs. HIGH → payee_screen 'complir_high' (R1 SCREEN_FAIL, cannot be approved);
+    MEDIUM → per-tx cap lowered to CompliR's recommended limit, so a larger request takes the owner-approval path (R3);
+    LOW → unchanged. A denylist hit always wins, and both inputs are part of the hashed decision record."""
+    if v is None or payee_screen != "clear":
+        return payee_screen, per_tx_cap
+    if v.get("tier") == "HIGH":
+        return "complir_high", per_tx_cap
+    if v.get("tier") == "MEDIUM":
+        return payee_screen, min(per_tx_cap, int(round(float(v["recommendedLimits"]["maxPerTxUsdc"]) * 1e6)))
+    return payee_screen, per_tx_cap
