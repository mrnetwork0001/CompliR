diff --git a/tests/complir.test.ts b/tests/complir.test.ts
new file mode 100644
index 0000000..fb9c569
--- /dev/null
+++ b/tests/complir.test.ts
@@ -0,0 +1,67 @@
+import { describe, expect, it } from "vitest";
+import { planScreening, screenBundledName, type CounterpartyScreeningRow } from "@/lib/compliance";
+import { mergeCompliR, riskLevelForTier, type CompliRVerdict } from "@/lib/complir";
+
+function verdict(over: Partial<CompliRVerdict> = {}): CompliRVerdict {
+  return {
+    address: "0x840de234bfc3f66fa380888a0a8204d9487d60d4",
+    score: 37,
+    tier: "MEDIUM",
+    recommendedLimits: { maxPerTxUsdc: 250, maxPerDayUsdc: 1000 },
+    reasons: [{ code: "FUNDER_2HOP_SANCTIONED", weight: 25 }],
+    rationale: "A wallet two hops back is sanctioned.",
+    attestation: { typedData: {}, signature: "0xsig", attester: "0xattester", validUntil: 1_800_000_000, registryTx: null },
+    decisionId: "dec_01J",
+    ...over,
+  };
+}
+
+const row: CounterpartyScreeningRow = {
+  id: "cp-1",
+  name: "Vercel Inc",
+  risk_level: "unscreened",
+  payment_limit: 2000,
+  baseline_payment_limit: null,
+  last_screened_at: null,
+  address: "0x840de234bfc3f66fa380888a0a8204d9487d60d4",
+};
+
+describe("CompliR beside the name screening", () => {
+  it("maps its tiers onto this codebase's risk levels", () => {
+    expect(riskLevelForTier("LOW")).toBe("clear");
+    expect(riskLevelForTier("MEDIUM")).toBe("medium");
+    expect(riskLevelForTier("HIGH")).toBe("high");
+  });
+
+  it("takes the stricter verdict and keeps the limit, the decision id and the signed attestation", () => {
+    const merged = mergeCompliR(screenBundledName("Vercel Inc"), verdict());
+    expect(merged.riskLevel).toBe("medium");
+    expect(merged.source).toBe("complir");
+    expect(merged.notes).toContain("CompliR MEDIUM 37/100 (FUNDER_2HOP_SANCTIONED)");
+    expect(merged.recommendedLimit).toBe(250);
+    expect(merged.complir?.decisionId).toBe("dec_01J");
+    expect(merged.complir?.attestation.signature).toBe("0xsig");
+  });
+
+  it("never loosens a name-screening verdict", () => {
+    const merged = mergeCompliR(screenBundledName("Zenith Trading"), verdict({ tier: "LOW" }));
+    expect(merged.riskLevel).toBe("high");
+    expect(merged.source).toBe("simulated-sanctions-list");
+  });
+
+  it("caps the tiered limit with CompliR's recommended figure, and high still means zero", () => {
+    const medium = planScreening(row, mergeCompliR(screenBundledName("Vercel Inc"), verdict()));
+    expect(medium.newLimit).toBe(250); // min(25% of 2000, 250)
+    const generous = planScreening(row, mergeCompliR(screenBundledName("Vercel Inc"), verdict({ recommendedLimits: { maxPerTxUsdc: 900, maxPerDayUsdc: 5000 } })));
+    expect(generous.newLimit).toBe(500); // the tier's 25% is the lower of the two
+    const high = planScreening(row, mergeCompliR(screenBundledName("Vercel Inc"), verdict({ tier: "HIGH", score: 80 })));
+    expect(high.newLimit).toBe(0);
+  });
+
+  it("changes nothing without CompliR", () => {
+    const plan = planScreening(row);
+    expect(plan.result.riskLevel).toBe("clear");
+    expect(plan.newLimit).toBe(2000);
+    expect(plan.result.complir).toBeUndefined();
+  });
+});
