diff --git a/src/lib/complir.ts b/src/lib/complir.ts
new file mode 100644
index 0000000..18c3ecc
--- /dev/null
+++ b/src/lib/complir.ts
@@ -0,0 +1,137 @@
+import { privateKeyToAccount } from "viem/accounts";
+import { toHex } from "viem";
+import { z } from "zod";
+import { currentConfig } from "./context";
+import type { ScreeningResult } from "./compliance";
+
+/**
+ * CompliR (https://github.com/mrnetwork0001/complir): a counterparty risk oracle on Arc. One call grades an
+ * *address* (2-hop funder trace on Arc, OpenSanctions, USDC blacklist, lookalike of a known payee) into a 0–100
+ * score, a tier, a recommended per-payment limit and an EIP-712 attestation signed by CompliR's attester key and
+ * mirrored to its registry on Arc. It sits beside the name screening in compliance.ts: that answers "who is this",
+ * CompliR answers "where did this wallet's money come from". Off unless COMPLIR_URL is set; then it runs in the
+ * same sweep, after the name screening, and the stricter verdict wins. The call is x402-paid (0.01 USDC), signed
+ * by COMPLIR_PAYER_PRIVATE_KEY, a small purse that is not the treasury.
+ */
+
+export const complirVerdictSchema = z.object({
+  address: z.string(),
+  score: z.number().min(0).max(100),
+  tier: z.enum(["LOW", "MEDIUM", "HIGH"]),
+  recommendedLimits: z.object({ maxPerTxUsdc: z.number().nonnegative(), maxPerDayUsdc: z.number().nonnegative() }),
+  reasons: z.array(z.object({ code: z.string(), weight: z.number() })).default([]),
+  rationale: z.string().default(""),
+  attestation: z.object({
+    typedData: z.unknown(),
+    signature: z.string(),
+    attester: z.string(),
+    validUntil: z.number(),
+    registryTx: z.string().nullable(),
+  }),
+  decisionId: z.string(),
+  nextRescreenAt: z.string().optional(),
+});
+export type CompliRVerdict = z.infer<typeof complirVerdictSchema>;
+
+/** What a screening keeps of a verdict: enough to verify the attestation offline and to replay the decision. */
+export type CompliRSummary = Pick<CompliRVerdict, "tier" | "score" | "decisionId" | "recommendedLimits" | "attestation" | "nextRescreenAt">;
+
+export function complirEnabled(): boolean {
+  return !!currentConfig().compliance.complirUrl;
+}
+
+const RISK_FOR_TIER = { LOW: "clear", MEDIUM: "medium", HIGH: "high" } as const;
+const RANK = { clear: 0, medium: 1, high: 2 } as const;
+
+export function riskLevelForTier(tier: CompliRVerdict["tier"]): "clear" | "medium" | "high" {
+  return RISK_FOR_TIER[tier];
+}
+
+/**
+ * The stricter of the name screening and CompliR's verdict, with CompliR's recommended limit and signed attestation
+ * carried along so `planScreening` can cap the limit and the ledger entry can keep the attestation.
+ */
+export function mergeCompliR(base: ScreeningResult, verdict: CompliRVerdict): ScreeningResult {
+  const level = riskLevelForTier(verdict.tier);
+  const stricter = RANK[level] > RANK[base.riskLevel];
+  const codes = verdict.reasons.map((reason) => reason.code).join(", ");
+  return {
+    ...base,
+    riskLevel: stricter ? level : base.riskLevel,
+    notes: `${base.notes}; CompliR ${verdict.tier} ${verdict.score}/100${codes ? ` (${codes})` : ""}`,
+    source: stricter ? "complir" : base.source,
+    recommendedLimit: verdict.recommendedLimits.maxPerTxUsdc,
+    complir: {
+      tier: verdict.tier,
+      score: verdict.score,
+      decisionId: verdict.decisionId,
+      recommendedLimits: verdict.recommendedLimits,
+      attestation: verdict.attestation,
+      nextRescreenAt: verdict.nextRescreenAt,
+    },
+  };
+}
+
+interface X402Offer {
+  scheme: string;
+  network: string;
+  amount: string;
+  asset: `0x${string}`;
+  payTo: `0x${string}`;
+  maxTimeoutSeconds?: number;
+  extra?: { name?: string; version?: string };
+}
+
+/** POST /api/v1/screen, paying the x402 `exact` (EIP-3009) price on a 402. Throws; the sweep records the failure. */
+export async function screenAddressWithCompliR(address: string, opts: { name?: string; amountUsdc?: number } = {}): Promise<CompliRVerdict> {
+  const { complirUrl, complirPayerKey } = currentConfig().compliance;
+  if (!complirUrl) throw new Error("COMPLIR_URL is not set");
+  const url = `${complirUrl.replace(/\/+$/, "")}/api/v1/screen`;
+  const body = JSON.stringify({ address, name: opts.name, amountUsdc: opts.amountUsdc, clientId: "vestiarion" });
+  const post = (headers: Record<string, string> = {}) =>
+    fetch(url, { method: "POST", headers: { "Content-Type": "application/json", ...headers }, body, signal: AbortSignal.timeout(15_000), cache: "no-store" });
+
+  let response = await post();
+  if (response.status === 402) {
+    if (!complirPayerKey) throw new Error("CompliR asks 0.01 USDC per screen over x402; set COMPLIR_PAYER_PRIVATE_KEY");
+    response = await post({ "PAYMENT-SIGNATURE": await signX402(response, complirPayerKey) });
+  }
+  if (!response.ok) throw new Error(`CompliR screening failed with HTTP ${response.status}`);
+  const parsed = complirVerdictSchema.safeParse(await response.json());
+  if (!parsed.success) throw new Error("CompliR returned an invalid verdict");
+  return parsed.data;
+}
+
+/** x402 v2: sign a TransferWithAuthorization for the first `exact` offer on an EVM network, never above 1 USDC. */
+async function signX402(res: Response, privateKey: `0x${string}`): Promise<string> {
+  const header = res.headers.get("PAYMENT-REQUIRED");
+  const required = (header ? JSON.parse(Buffer.from(header, "base64").toString("utf8")) : await res.json()) as { resource?: unknown; accepts?: X402Offer[] };
+  const offer = required.accepts?.find((option) => option.scheme === "exact" && /^eip155:\d+$/.test(option.network));
+  if (!offer) throw new Error("CompliR offered no x402 `exact` payment on an EVM network");
+  if (BigInt(offer.amount) > 1_000_000n) throw new Error(`CompliR asks ${offer.amount} atomic USDC per screen, above the 1 USDC cap`);
+  const account = privateKeyToAccount(privateKey);
+  const authorization = {
+    from: account.address,
+    to: offer.payTo,
+    value: offer.amount,
+    validAfter: "0",
+    validBefore: String(Math.floor(Date.now() / 1000) + (offer.maxTimeoutSeconds ?? 60) + 540),
+    nonce: toHex(crypto.getRandomValues(new Uint8Array(32))),
+  };
+  const signature = await account.signTypedData({
+    domain: { name: offer.extra?.name ?? "USDC", version: offer.extra?.version ?? "2", chainId: Number(offer.network.split(":")[1]), verifyingContract: offer.asset },
+    types: {
+      TransferWithAuthorization: [
+        { name: "from", type: "address" },
+        { name: "to", type: "address" },
+        { name: "value", type: "uint256" },
+        { name: "validAfter", type: "uint256" },
+        { name: "validBefore", type: "uint256" },
+        { name: "nonce", type: "bytes32" },
+      ],
+    },
+    primaryType: "TransferWithAuthorization",
+    message: { ...authorization, value: BigInt(authorization.value), validAfter: 0n, validBefore: BigInt(authorization.validBefore) },
+  });
+  return Buffer.from(JSON.stringify({ x402Version: 2, resource: required.resource, accepted: offer, payload: { signature, authorization } })).toString("base64");
+}
