diff --git a/agent/tests/test_complir.py b/agent/tests/test_complir.py
new file mode 100644
index 0000000..12ef3fd
--- /dev/null
+++ b/agent/tests/test_complir.py
@@ -0,0 +1,46 @@
+"""CompliR screening sits after the vendor registry: off without COMPLIR_URL, HIGH escalates, MEDIUM caps, LOW passes."""
+import asyncio
+
+from agent import complir, payables
+from agent.config import config
+
+
+def _verdict(tier, max_per_tx=5.0):
+    return {"tier": tier, "score": 30, "recommendedLimits": {"maxPerTxUsdc": max_per_tx, "maxPerDayUsdc": 50.0}, "decisionId": "dec_1"}
+
+
+def _invoice(amount=10.0):
+    return payables.Invoice(business_id=1, id=1, invoice_number="INV-1", vendor_wallet="0xVENDOR", amount_usdc=amount,
+                            category=0, doc_hash="00" * 32, po_number="PO-1")
+
+
+def test_gate_maps_tiers_onto_escalation():
+    assert complir.gate(None, 10.0) is None
+    assert complir.gate(_verdict("LOW"), 10.0) is None
+    assert complir.gate(_verdict("MEDIUM", 20.0), 10.0) is None
+    assert "MEDIUM" in complir.gate(_verdict("MEDIUM", 5.0), 10.0)
+    assert "dec_1" in complir.gate(_verdict("HIGH"), 0.5)
+
+
+def test_screen_is_off_without_a_url(monkeypatch):
+    monkeypatch.setattr(config, "complir_url", "")
+    assert asyncio.run(complir.screen("0xVENDOR", 10.0)) is None
+
+
+def test_decide_escalates_a_vendor_complir_grades_high(chain, monkeypatch):
+    async def high(wallet, amount):
+        return _verdict("HIGH")
+
+    monkeypatch.setattr(payables.complir, "screen", high)
+    decision, reason = asyncio.run(payables.decide(_invoice(), 30, chain))
+    assert decision == payables.Decision.ESCALATE
+    assert "CompliR" in reason
+
+
+def test_decide_pays_a_low_tier_vendor_as_before(chain, monkeypatch):
+    async def low(wallet, amount):
+        return _verdict("LOW")
+
+    monkeypatch.setattr(payables.complir, "screen", low)
+    decision, _ = asyncio.run(payables.decide(_invoice(), 30, chain))
+    assert decision == payables.Decision.PAY
