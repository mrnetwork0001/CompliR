@@ -281,6 +281,7 @@ One instance per business. This deployment is not multi-tenant, and a second bus
 ### `BudgetEnforcerV2.sol`, `BudgetFactory.sol`, `LedgerAnchor.sol` (v1.2.8)
 
 - **`BudgetEnforcerV2`** keeps everything above and adds a rolling 7-day limit (`setBudget(daily, perTx, weekly)` requires `0 < perTx <= daily <= weekly`), `reopenEscalation` (approver only, only for a Pending escalation, so the agent can re-evaluate and then pay through every normal limit or escalate again), commitments bound to the contract address and chain id, and distinct agent and approver roles.
+- **CompliR gate (opt-in)**: the approver can `setComplir(registry)` on a `BudgetEnforcerV2`; `pay()` then also requires `ICompliR(registry).isAllowed(vendor, Tier.MEDIUM)`, so a vendor whose [CompliR](https://github.com/mrnetwork0001/complir) attestation on Arc says HIGH is refused by the contract itself, whatever the agent was convinced of. Zero (the default) disables it. The agent runs the same screen off-chain before proposing a payment when `COMPLIR_URL` is set (`agent/complir.py`).
 - **`BudgetFactory`**: `createBusiness(agent, daily, perTx, weekly)` deploys one enforcer per business, and the caller becomes its approver. The factory has no admin function, holds no funds and cannot touch any enforcer.
 - **`LedgerAnchor`**: `anchor(head, sequence)` records a ledger head per sender, and the sequence must increase. A verifier trusts only events from a business's agent address.
 
diff --git a/agent/complir.py b/agent/complir.py
new file mode 100644
index 0000000..bde20b5
--- /dev/null
+++ b/agent/complir.py
@@ -0,0 +1,82 @@
+"""CompliR (https://github.com/mrnetwork0001/complir): counterparty risk oracle on Arc. One call grades a wallet (2-hop funder
+trace, OpenSanctions, USDC blacklist, lookalikes) into a 0–100 score, a tier, a recommended per-payment limit and a signed
+EIP-712 attestation. Off unless COMPLIR_URL is set; `payables.decide` runs it after the on-chain vendor registry. The call is
+x402-paid (0.01 USDC, EIP-3009), signed by COMPLIR_PAYER_PRIVATE_KEY; with no key a 402 is logged and the vendor passes as before.
+"""
+import base64
+import json
+import logging
+import os
+import time
+from typing import Optional
+
+import httpx
+from eth_account import Account
+from web3 import Web3
+
+from agent.config import config
+
+log = logging.getLogger(__name__)
+_AUTH_TYPES = {"TransferWithAuthorization": [{"name": "from", "type": "address"}, {"name": "to", "type": "address"},
+                                             {"name": "value", "type": "uint256"}, {"name": "validAfter", "type": "uint256"},
+                                             {"name": "validBefore", "type": "uint256"}, {"name": "nonce", "type": "bytes32"}]}
+
+
+def _payment_header(required: dict) -> Optional[str]:
+    """Signs the first `exact` / eip155 requirement of an x402 v2 402 with the payer key; None without a key or above 1 USDC."""
+    key = config.complir_payer_private_key
+    if not key:
+        return None
+    req = next((a for a in required.get("accepts", []) if a.get("scheme") == "exact" and str(a.get("network", "")).startswith("eip155:")), None)
+    if req is None or int(req["amount"]) > 1_000_000:
+        return None
+    extra, acct = req.get("extra") or {}, Account.from_key(key)
+    auth = {"from": acct.address, "to": req["payTo"], "value": str(req["amount"]), "validAfter": "0",
+            "validBefore": str(int(time.time()) + int(req.get("maxTimeoutSeconds", 60)) + 540), "nonce": Web3.to_hex(os.urandom(32))}
+    domain = {"name": extra.get("name", "USDC"), "version": extra.get("version", "2"),
+              "chainId": int(req["network"].split(":")[1]), "verifyingContract": req["asset"]}
+    msg = {**auth, "value": int(auth["value"]), "validAfter": 0, "validBefore": int(auth["validBefore"]), "nonce": bytes.fromhex(auth["nonce"][2:])}
+    sig = Web3.to_hex(Account.sign_typed_data(key, domain, _AUTH_TYPES, msg).signature)
+    payload = {"x402Version": 2, "resource": required.get("resource"), "accepted": req, "payload": {"signature": sig, "authorization": auth}}
+    return base64.b64encode(json.dumps(payload).encode()).decode()
+
+
+async def screen(vendor_wallet: str, amount_usdc: float) -> Optional[dict]:
+    """POST /api/v1/screen → verdict (tier, score, recommendedLimits, decisionId, attestation), or None when CompliR is off,
+    unpaid or unreachable. None never changes a decision: the registry, the match and the contract's limits still apply."""
+    if not config.complir_url:
+        return None
+    url = f"{config.complir_url.rstrip('/')}/api/v1/screen"
+    body = {"address": vendor_wallet, "amountUsdc": amount_usdc, "clientId": "ceedebooks"}
+    try:
+        async with httpx.AsyncClient(timeout=15) as client:
+            r = await client.post(url, json=body)
+            if r.status_code == 402:
+                required = r.headers.get("PAYMENT-REQUIRED")
+                sig = _payment_header(json.loads(base64.b64decode(required)) if required else r.json())
+                if sig is None:
+                    log.warning("CompliR asks for payment and COMPLIR_PAYER_PRIVATE_KEY is not set; vendor not screened")
+                    return None
+                r = await client.post(url, json=body, headers={"PAYMENT-SIGNATURE": sig})
+            r.raise_for_status()
+            v = r.json()
+            log.info("CompliR %s: tier=%s score=%s decision=%s", vendor_wallet[:10], v.get("tier"), v.get("score"), v.get("decisionId"))
+            return v
+    except Exception:
+        log.exception("CompliR screening failed; vendor %s not screened this time", vendor_wallet[:10])
+        return None
+
+
+def gate(verdict: Optional[dict], amount_usdc: float) -> Optional[str]:
+    """The reason to escalate, or None. HIGH escalates; MEDIUM escalates an amount above CompliR's recommended per-payment
+    limit; LOW passes. The text goes into the hashed reasoning, so the verdict's decision id is replayable from the ledger."""
+    if not verdict:
+        return None
+    tier, decision = verdict.get("tier"), verdict.get("decisionId", "?")
+    if tier == "HIGH":
+        return f"CompliR grades this vendor HIGH risk ({verdict.get('score')}/100, decision {decision}); held for review"
+    if tier == "MEDIUM":
+        limit = float((verdict.get("recommendedLimits") or {}).get("maxPerTxUsdc", 0))
+        if amount_usdc > limit:
+            return f"CompliR grades this vendor MEDIUM risk with a {limit:g} USDC per-payment limit (decision {decision}); {amount_usdc:g} USDC is above it"
+    return None
