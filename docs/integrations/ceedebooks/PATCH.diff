diff --git a/test/mocks/MockCompliR.sol b/test/mocks/MockCompliR.sol
new file mode 100644
index 0000000..178eb43
--- /dev/null
+++ b/test/mocks/MockCompliR.sol
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import {ICompliR} from "../../contracts/interfaces/ICompliR.sol";
+
+/// @notice Test double for the CompliR registry: tiers are set by hand and never expire.
+contract MockCompliR is ICompliR {
+    mapping(address => Tier) public tiers;
+
+    function set(address subject, Tier tier) external {
+        tiers[subject] = tier;
+    }
+
+    function tierOf(address subject) external view returns (Tier tier, uint64 validUntil, bytes32 decisionHash) {
+        return (tiers[subject], type(uint64).max, bytes32(0));
+    }
+
+    function isAllowed(address subject, Tier maxTier) external view returns (bool) {
+        return tiers[subject] != Tier.UNKNOWN && tiers[subject] <= maxTier;
+    }
+}
