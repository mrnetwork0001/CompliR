+/**
+ * Optional CompliR screening of a payment recipient (no-op unless COMPLIR_URL is set).
+ * Runs server-side so the CompliR host is never exposed to the browser.
+ */
+export const screenRecipientAction = async (
+  address: string
+): Promise<ComplirCheck> => {
+  const supabase = await createSupabaseServerClient();
+  const {
+    data: { user },
+  } = await supabase.auth.getUser();
+  if (!user) return { allowed: false, reason: "unauthenticated" };
+  return complirCheck(address);
+};
