+/**
+ * Optional counterparty screening via CompliR (https://github.com/mrnetwork0001/complir).
+ * Enabled by setting COMPLIR_URL; with it unset every check passes ("disabled").
+ *
+ * This is the free tier lookup: GET <COMPLIR_URL>/api/v1/attestation/<address>.
+ * HIGH blocks, LOW and MEDIUM pass. A network error or timeout fails open with a
+ * warning so a CompliR outage never stops payments, and this check never loosens
+ * any other check the app already runs.
+ */
+
+export interface ComplirCheck {
+  allowed: boolean;
+  tier?: string;
+  score?: number;
+  decisionId?: string;
+  reason?: string;
+}
+
+const TIMEOUT_MS = 8_000;
+
+export async function complirCheck(address: string): Promise<ComplirCheck> {
+  const baseUrl = process.env.COMPLIR_URL;
+  if (!baseUrl) return { allowed: true, reason: "disabled" };
+
+  try {
+    const res = await fetch(
+      `${baseUrl.replace(/\/$/, "")}/api/v1/attestation/${encodeURIComponent(address)}`,
+      { signal: AbortSignal.timeout(TIMEOUT_MS), cache: "no-store" },
+    );
+    if (!res.ok) {
+      console.warn(`CompliR: HTTP ${res.status} for ${address}, failing open`);
+      return { allowed: true, reason: `http_${res.status}` };
+    }
+    const data = (await res.json()) as {
+      tier?: string;
+      score?: number;
+      decisionId?: string;
+    };
+    const tier = data.tier ?? "UNKNOWN";
+    return {
+      allowed: tier !== "HIGH",
+      tier,
+      score: data.score,
+      decisionId: data.decisionId,
+      reason: tier === "HIGH" ? "tier_high" : undefined,
+    };
+  } catch (error) {
+    console.warn("CompliR: screening unavailable, failing open", error);
+    return { allowed: true, reason: "unavailable" };
+  }
+}
